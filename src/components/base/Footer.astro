---
import Link from '~/components/base/Link.astro'

const currentYear = new Date().getFullYear()
const copyrightHolder = '蓝厘榨只因'
---

<footer class="slide-enter animate-delay-1600! px-7 mt-auto mb-8">
  <div class="prose mx-auto op-50">
    <div class="flex lt-sm:flex-col items-center text-sm whitespace-nowrap">
      <span>© {currentYear} {copyrightHolder}</span>
      <span class="lt-sm:hidden">&nbsp;|&nbsp;</span>
      <span>
        Powered by
        {' '}
        <Link
          class="op-100! color-[--fg]!"
          href="https://github.com/lin-stephanie/astro-antfustyle-theme"
          external={true}
        >
          Astro AntfuStyle Theme
        </Link>
      </span>
    </div>
    <div
      class="mt-1 flex lt-sm:flex-col justify-center items-center text-xs whitespace-nowrap"
    >
      <Link class="op-100!" href="https://beian.miit.gov.cn/" external={true}>
        粤ICP备2026019032号
      </Link>
      <span class="lt-sm:hidden mx-1">&nbsp;|&nbsp;</span>
      <Link
        class="op-100!"
        href="https://beian.mps.gov.cn/#/query/webSearch?code=44010502003920"
        external={true}
      >
        粤公网安备44010502003920号
      </Link>
    </div>
  </div>
</footer>
