---
import Link from '~/components/base/Link.astro'
import { withBasePath } from '~/utils/path'
import { SITE } from '~/config'
---

<Link
  class="select-none op-transition"
  href={withBasePath('/')}
  aria-label={SITE.author}
  aria-current={Astro.url.pathname === `${withBasePath('/')}` ? 'page' : false}
>
  <div class="logo-container">
    <!-- Use the shared logo asset, so the site logo has a single source. -->
    <span
      class="logo-mark"
      aria-hidden="true"
      style={`--logo-mark: url('${withBasePath('/logo.svg')}')`}
    >
    </span>
  </div>
</Link>

<style>
  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;

    transform: scale(1.05);
  }

  /*
   * Paint the logo as a mask so it always takes the current text color.
   * A plain <img> would follow the OS color scheme (from the SVG's own
   * `prefers-color-scheme` query), which can disagree with the site's
   * `.dark` class and make the mark invisible.
   */
  .logo-mark {
    display: block;
    width: 2rem;
    height: 2rem;

    background-color: currentColor;
    -webkit-mask: var(--logo-mark) center / contain no-repeat;
    mask: var(--logo-mark) center / contain no-repeat;
  }

  @media (max-width: 767.9px) {
    .logo-container {
      margin-top: 0.125rem;

      transform-origin: 0%;
      transform: scale(0.95);
    }
  }
</style>
